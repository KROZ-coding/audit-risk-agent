# ─── LLM 配置 ───────────────────────────────────────────
# DeepSeek API（推荐）: https://platform.deepseek.com/
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com

# 辩论复核专用模型（可选，默认 deepseek-v4-flash；主分析模型在
# config/agent_llm_config.json 的 model 字段配置，当前全链路 deepseek-v4-flash
# 速度优先，如需更强推理可改回 deepseek-v4-pro）
# REVIEW_MODEL=deepseek-v4-flash

# 快速模式主分析模型（可选，默认 deepseek-v4-flash：前端 ⚡ 开关开启后生效，
# 与跳过辩论复核叠加提速；普通模式始终使用 config 中的主模型）
# FAST_MODEL=deepseek-v4-flash

# 备选 - 通义千问:
# OPENAI_API_KEY=sk-your-qwen-api-key-here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 备选 - 智谱 GLM:
# OPENAI_API_KEY=your-glm-api-key-here
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ─── 项目路径（Windows 路径用正斜杠）────────────────────
# 留空即可，启动脚本会自动填充为当前项目目录
COZE_WORKSPACE_PATH=

# ─── 数据库（可选，不设置则自动使用 SQLite）──────────────
# PGDATABASE_URL=postgresql://user:pass@localhost:5432/audit_db

# ─── 日志级别: DEBUG / INFO / WARNING / ERROR ────────────
LOG_LEVEL=INFO

# ─── 安全（可选）──────────────────────────────────
# 监听地址：默认 127.0.0.1 仅本机访问；需局域网/容器访问时放开为 0.0.0.0
# HOST=127.0.0.1
# 写操作接口鉴权密钥：设置后 /run /stream_run /upload 等接口需携带 X-API-Key 请求头；
# 前端配套：浏览器控制台执行 localStorage.setItem('audit_api_key','与此处相同的值')
# APP_API_KEY=

# ─── 运行环境: dev / prod ────────────────────────────────
ENV=dev

# ─── 运行时资源定期回收（可选）────────────────────────────
# 后台每 N 小时自动回收检查点/旧产物/旧日志/临时文件；默认开启。
# MAINTENANCE_ENABLED=true
# MAINTENANCE_INTERVAL_HOURS=24
# 只预览不删除（上线初期建议先设 true 观察一次）：
# MAINTENANCE_DRY_RUN=false
# 检查点库超过该体积才回收，且始终保留最近 N 个线程：
# MAINTENANCE_CHECKPOINT_MAX_MB=512
# MAINTENANCE_CHECKPOINT_KEEP_THREADS=50
# 旧产物/日志/临时文件保留天数：
# MAINTENANCE_ARTIFACT_RETENTION_DAYS=30
# MAINTENANCE_LOG_RETENTION_DAYS=14
# MAINTENANCE_TEMP_RETENTION_DAYS=7
# 预览/手动回收命令：
# python scripts/maintenance_cli.py --dry-run
# python scripts/maintenance_cli.py --apply --sections checkpoints,artifacts,logs,temp
