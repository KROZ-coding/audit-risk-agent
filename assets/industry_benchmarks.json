{
  "_comment": "行业风险基准值表 - 用于年报审计风险识别中的行业对比分析。本文件被 visualizer.py（雷达图行业基准对比）和 agent 系统提示词中的行业基准阈值引用。结构说明：industries 下每个行业包含 benchmarks（8项财务指标的低/中/高基准值）和 risk_thresholds（5项风险预警阈值）。general_thresholds 为行业未知时的通用兜底阈值。",
  "description": "行业风险基准值表 - 用于年报审计风险识别中的行业对比分析",
  "version": "1.0",
  "_benchmarks_field_description": {
    "gross_margin": "毛利率(%) = (营收-营业成本)/营收 × 100，衡量核心盈利能力",
    "debt_to_asset_ratio": "资产负债率(%) = 总负债/总资产 × 100，衡量财务杠杆水平",
    "ar_to_revenue_ratio": "应收账款占营收比(%) = 应收账款/营收 × 100，衡量回款效率",
    "inventory_turnover": "存货周转率(次) = 营业成本/平均存货，衡量存货管理效率",
    "current_ratio": "流动比率(倍) = 流动资产/流动负债，衡量短期偿债能力",
    "quick_ratio": "速动比率(倍) = (流动资产-存货)/流动负债，更严格的流动性指标",
    "cashflow_to_profit_ratio": "经营现金流/净利润比(倍)，衡量利润含金量",
    "goodwill_to_net_assets": "商誉占净资产比(%)，衡量商誉减值风险敞口"
  },
  "_thresholds_field_description": {
    "revenue_yoy_alert": "营收同比变动预警阈值(%)，超过此值触发营收异常告警",
    "gross_margin_deviation": "毛利率偏离行业基准阈值(百分点)，偏离超过此值触发盈利能力告警",
    "ar_growth_alert_ratio": "应收增速/营收增速的预警倍数，超过此值触发回款风险告警",
    "inventory_growth_alert_ratio": "存货增速的预警倍数（相对前期），超过此值触发存货积压告警",
    "cashflow_negative_years": "经营现金流连续为负的预警年数，达到此年数触发持续经营告警"
  },
